# Copy to .env and fill in. .env is git-ignored and must never be committed.
DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full
AWS_REGION=us-east-1
# Non-root principal. AWS forbids root from assuming roles, so the
# read-only boundary cannot be exercised without this.
AWS_PROFILE=biographer

# Bedrock. Defaults in config.py match what is confirmed enabled in the account;
# override only if that changes.
MODEL_STRONG=us.anthropic.claude-sonnet-4-5-20250929-v1:0
MODEL_CHEAP=us.anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_EMBED=amazon.titan-embed-text-v2:0
EMBED_DIM=1024

# The read-only role in the studied account. Never commit real values, and never
# publish this ARN anywhere -- repo, README, video, or Devpost entry.
BIOGRAPHER_ROLE_ARN=
BIOGRAPHER_EXTERNAL_ID=

# CockroachDB Managed MCP Server -- the agent's read path.
# A service account API key, NOT interactive OAuth: the agent runs in Lambda
# where nobody is present to approve a browser prompt.
CRDB_API_KEY=
CRDB_CLUSTER_ID=
